# ---------------------------------------------------------------------------
# The Boamah's Online Grocery Shop — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Public base URL of the site (no trailing slash). Used for auth callbacks,
# payment callbacks, canonical URLs, sitemap and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production only: other addresses of the same site (comma-separated, e.g. the
# Railway address) redirect to NEXT_PUBLIC_SITE_URL. www. is redirected
# automatically; /api is never redirected.
REDIRECT_HOSTS=
# In-shop till address. Empty = pos.<domain of NEXT_PUBLIC_SITE_URL> in production,
# and /pos on this server locally.
POS_HOST=

# --- Database (PostgreSQL) -------------------------------------------------
# Local Docker default (see docker-compose.yml). For Neon/Supabase use the
# pooled connection string for DATABASE_URL and the direct (non-pooled) one
# for DIRECT_DATABASE_URL, which Prisma migrations use. Leave it empty locally.
DATABASE_URL=postgresql://boamah:boamah_local_dev@localhost:5439/boamah
DIRECT_DATABASE_URL=
# Only used by integration tests (must point at a disposable database).
TEST_DATABASE_URL=postgresql://boamah:boamah_local_dev@localhost:5439/boamah_test

# --- Authentication (Better Auth) ------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Payments: Paystack ----------------------------------------------------
# Use sk_test_ keys until the merchant account is approved for live.
# Leave empty to disable online payments (Cash on Delivery still works if
# enabled in Admin -> Settings).
PAYSTACK_SECRET_KEY=
# Development only: set to "true" to enable the local mock payment gateway
# for testing the checkout flow without Paystack. Refused in production.
PAYMENTS_MOCK=false

# --- Email: Resend (optional) ----------------------------------------------
# Without a key, emails are recorded as SKIPPED in Admin -> Notifications.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Boamah's Grocery <orders@yourdomain.com>"
EMAIL_FROM=

# --- SMS (optional) --------------------------------------------------------
# Provider adapter: "none" | "arkesel"
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=

# --- File storage for admin image uploads ----------------------------------
# On Vercel, create a Blob store and set this token. On Railway, attach a
# volume (e.g. at /data) and set UPLOAD_DIR to a folder on it instead. Locally,
# uploads are written to public/uploads when both are empty.
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=

# --- Scheduled jobs --------------------------------------------------------
# Shared secret sent as "Authorization: Bearer <CRON_SECRET>" by Vercel Cron
# or by scripts/expire-orders.mjs (Railway cron service).
CRON_SECRET=replace-with-a-random-string

# --- Performance -----------------------------------------------------------
# Seconds the storefront reuses shared data (catalogue, categories, banners,
# settings, reviews) between shoppers. Empty = 60 in production, off in
# development. Admin changes clear it at once; checkout always reads live data.
STOREFRONT_CACHE_SECONDS=
