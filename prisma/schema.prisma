// The Boamah's Online Grocery Shop — database schema
//
// Conventions
// - Money is stored as integer minor units (pesewas): GHS 12.50 => 1250.
// - Quantities and stock are stored as integer milli-units: 1 item => 1000,
//   1.5 kg => 1500. This supports items sold by weight without floats.
// - All timestamps are stored in UTC.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  SUPER_ADMIN
  STORE_MANAGER
  INVENTORY_MANAGER
  ORDER_MANAGER
  CASHIER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  phone         String?
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions           Session[]
  accounts           Account[]
  addresses          Address[]
  cart               Cart?
  wishlistItems      WishlistItem[]
  orders             Order[]
  inventoryMovements InventoryMovement[]
  statusChanges      OrderStatusHistory[]
  orderNotes         OrderNote[]
  auditLogs          AuditLog[]
  cashPayments       Payment[]            @relation("PaymentRecordedBy")
  reviews            Review[]
  stockAlerts        StockAlert[]
  posSales           PosSale[]            @relation("PosSaleCashier")
  posShifts          PosShift[]           @relation("PosShiftCashier")
  posSalesVoided     PosSale[]            @relation("PosSaleVoidedBy")
  posSalesReviewed   PosSale[]            @relation("PosSaleReviewedBy")
  posShiftsReviewed  PosShift[]           @relation("PosShiftReviewedBy")
  posReturns         PosReturn[]          @relation("PosReturnCashier")
  posReturnsApproved PosReturn[]          @relation("PosReturnApprovedBy")
  posReturnsReviewed PosReturn[]          @relation("PosReturnReviewedBy")

  @@index([role])
  @@index([createdAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

model Address {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String?
  recipientName String
  phone         String
  region        String
  city          String
  area          String
  addressLine   String
  details       String?
  zoneId        String?
  zone          DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  coupons     Coupon[]  @relation("CouponCategories")

  @@index([isActive, sortOrder])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  description      String
  shortDescription String?
  searchKeywords   String           @default("")
  /// The maker's brand, e.g. "Quaker". Google needs a brand or a barcode to identify a product.
  brand            String?
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status           ProductStatus    @default(DRAFT)
  isFeatured       Boolean          @default(false)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  images           ProductImage[]
  variants         ProductVariant[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  coupons          Coupon[]         @relation("CouponProducts")
  reviews          Review[]

  @@index([status, categoryId])
  @@index([status, isFeatured])
  @@index([status, publishedAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  credit    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

enum SellingUnit {
  ITEM
  KG
  PACK
  BOTTLE
  BAG
  BOX
  BUNCH
  CRATE
  TIN
  LOAF
  LITRE
  DOZEN
}

model ProductVariant {
  id             String              @id @default(cuid())
  productId      String
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  sku            String              @unique
  /// EAN/UPC (or the shop's own code) scanned at the till. Optional and unique.
  barcode        String?             @unique
  unit           SellingUnit         @default(ITEM)
  priceMinor     Int
  salePriceMinor Int?
  // The sale price stops applying at this moment; null means no end date.
  saleEndsAt     DateTime?
  // Quantity rules in milli-units (1000 = one unit).
  stepMilli      Int                 @default(1000)
  minQtyMilli    Int                 @default(1000)
  maxQtyMilli    Int?
  stockMilli     Int                 @default(0)
  lowStockMilli  Int                 @default(5000)
  isDefault      Boolean             @default(false)
  isActive       Boolean             @default(true)
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  cartItems      CartItem[]
  orderItems     OrderItem[]
  movements      InventoryMovement[]
  priceTiers     PriceTier[]
  stockAlerts    StockAlert[]
  posSaleItems   PosSaleItem[]

  @@index([productId, sortOrder])
  @@index([stockMilli])
}

// Bulk pricing: buying at least minQtyMilli makes every unit cost
// unitPriceMinor, when that is lower than the regular or sale price.
model PriceTier {
  id             String         @id @default(cuid())
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  minQtyMilli    Int
  unitPriceMinor Int
  createdAt      DateTime       @default(now())

  @@unique([variantId, minQtyMilli])
}

// A shopper asked to be told when an out-of-stock option is back.
model StockAlert {
  id         String              @id @default(cuid())
  variantId  String
  variant    ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  channel    NotificationChannel
  // Lower-cased email address or normalised phone number.
  contact    String
  userId     String?
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  notifiedAt DateTime?
  createdAt  DateTime            @default(now())

  @@unique([variantId, contact])
  @@index([variantId, notifiedAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Only customers with a delivered order containing the product may review it.
// Reviews are published after a staff member approves them.
model Review {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating      Int
  title       String?
  body        String
  // Shown publicly, e.g. "Ama B."
  authorName  String
  status      ReviewStatus @default(PENDING)
  moderatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

enum InventoryMovementType {
  INITIAL
  RECEIPT
  ADJUSTMENT
  CORRECTION
  ORDER_RESERVED
  ORDER_RELEASED
  POS_SALE
  POS_VOID
  POS_RETURN
}

model InventoryMovement {
  id                String                @id @default(cuid())
  variantId         String
  variant           ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type              InventoryMovementType
  deltaMilli        Int
  balanceAfterMilli Int
  reason            String?
  orderId           String?
  order             Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  posSaleId         String?
  posSale           PosSale?              @relation(fields: [posSaleId], references: [id], onDelete: SetNull)
  posReturnId       String?
  posReturn         PosReturn?            @relation(fields: [posReturnId], references: [id], onDelete: SetNull)
  actorId           String?
  actor             User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now())

  // One reservation and at most one release per order line: prevents stock
  // being deducted or restored twice on retries / duplicate webhooks.
  @@unique([orderId, variantId, type])
  @@unique([posSaleId, variantId, type])
  @@unique([posReturnId, variantId, type])
  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([posSaleId])
  @@index([posReturnId])
}

// ---------------------------------------------------------------------------
// Cart & wishlist
// ---------------------------------------------------------------------------

model Cart {
  id         String     @id @default(cuid())
  // Random opaque token stored in an httpOnly cookie for guest carts.
  token      String     @unique
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id                 String         @id @default(cuid())
  cartId             String
  cart               Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId          String
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantityMilli      Int
  // Unit price the customer saw when adding; used to explain price changes.
  seenUnitPriceMinor Int
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------------------------------------------------------------------------
// Delivery & promotions
// ---------------------------------------------------------------------------

model DeliveryZone {
  id                         String    @id @default(cuid())
  name                       String
  region                     String
  // Areas / neighbourhoods covered by this zone.
  areas                      String[]
  feeMinor                   Int
  minOrderMinor              Int       @default(0)
  freeDeliveryThresholdMinor Int?
  estimatedDelivery          String?
  isActive                   Boolean   @default(true)
  sortOrder                  Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  orders                     Order[]
  addresses                  Address[]

  @@index([isActive, sortOrder])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponScope {
  ALL
  PRODUCTS
  CATEGORIES
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  description      String?
  type             DiscountType
  // PERCENTAGE: basis points (1000 = 10%). FIXED: minor units.
  value            Int
  maxDiscountMinor Int?
  minOrderMinor    Int                @default(0)
  scope            CouponScope        @default(ALL)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  usedCount        Int                @default(0)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  products         Product[]          @relation("CouponProducts")
  categories       Category[]         @relation("CouponCategories")
  redemptions      CouponRedemption[]
  orders           Order[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  email     String?
  createdAt DateTime @default(now())

  @@index([couponId, userId])
  @@index([couponId, email])
}

enum BannerPlacement {
  HERO
  HOME_PROMO
}

model PromoBanner {
  id        String          @id @default(cuid())
  placement BannerPlacement
  eyebrow   String?
  title     String
  subtitle  String?
  imageUrl  String
  ctaLabel  String?
  ctaHref   String?
  tone      String          @default("leaf")
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

// ---------------------------------------------------------------------------
// Orders & payments
// ---------------------------------------------------------------------------

enum FulfilmentMethod {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  PAYSTACK
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  UNPAID
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id                   String               @id @default(cuid())
  reference            String               @unique
  userId               String?
  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  // SHA-256 of a random token given to guests so they can view the order.
  guestTokenHash       String?
  // Client-generated key per checkout attempt; prevents duplicate orders on
  // double-submits and retries.
  idempotencyKey       String               @unique
  customerName         String
  email                String?
  phone                String
  fulfilmentMethod     FulfilmentMethod
  zoneId               String?
  zone                 DeliveryZone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  zoneName             String?
  region               String?
  city                 String?
  area                 String?
  addressLine          String?
  addressDetails       String?
  deliveryInstructions String?
  subtotalMinor        Int
  discountMinor        Int                  @default(0)
  deliveryFeeMinor     Int                  @default(0)
  taxMinor             Int                  @default(0)
  totalMinor           Int
  currency             String               @default("GHS")
  couponId             String?
  coupon               Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode           String?
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus
  status               OrderStatus
  paidAt               DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  deliveredAt          DateTime?
  // Online orders not paid before this time are cancelled and stock released.
  paymentDueAt         DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  items                OrderItem[]
  payments             Payment[]
  statusHistory        OrderStatusHistory[]
  notes                OrderNote[]
  movements            InventoryMovement[]
  redemption           CouponRedemption?
  notifications        Notification[]
  reviews              Review[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([paymentStatus, paymentDueAt])
  @@index([createdAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Snapshot at purchase time — historical orders never change.
  productName    String
  variantName    String
  sku            String
  unit           SellingUnit
  imageUrl       String?
  unitPriceMinor Int
  quantityMilli  Int
  lineTotalMinor Int

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

enum PaymentProvider {
  PAYSTACK
  MOCK
  CASH
}

enum PaymentRecordStatus {
  INITIALIZED
  SUCCESS
  FAILED
  ABANDONED
}

model Payment {
  id                    String              @id @default(cuid())
  orderId               String
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider              PaymentProvider
  reference             String              @unique
  amountMinor           Int
  currency              String              @default("GHS")
  status                PaymentRecordStatus @default(INITIALIZED)
  authorizationUrl      String?
  providerTransactionId String?
  channel               String?
  gatewayResponse       String?
  paidAt                DateTime?
  recordedById          String?
  recordedBy            User?               @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}

model PaymentEvent {
  id             String          @id @default(cuid())
  provider       PaymentProvider
  // Unique per provider event; duplicate deliveries are ignored.
  eventKey       String          @unique
  eventType      String
  reference      String?
  signatureValid Boolean
  payload        Json
  processedAt    DateTime?
  outcome        String?
  createdAt      DateTime        @default(now())

  @@index([reference])
}

// ---------------------------------------------------------------------------
// Settings, notifications & audit
// ---------------------------------------------------------------------------

model StoreSettings {
  id                       String   @id @default("default")
  storeName                String   @default("The Boamah's Online Grocery Shop")
  tagline                  String?
  logoUrl                  String?
  currency                 String   @default("GHS")
  contactEmail             String?
  contactPhone             String?
  whatsappNumber           String?
  address                  String?
  businessHours            String?
  announcementEnabled      Boolean  @default(false)
  announcementText         String?
  announcementLink         String?
  socialFacebook           String?
  socialInstagram          String?
  socialX                  String?
  socialTiktok             String?
  pickupEnabled            Boolean  @default(false)
  pickupAddress            String?
  pickupInstructions       String?
  codEnabled               Boolean  @default(false)
  onlinePaymentEnabled     Boolean  @default(true)
  pendingPaymentTtlMinutes Int      @default(60)
  deliveryPolicy           String?
  returnsPolicy            String?
  /// Days a customer has to return an item, for Google's product listings. 0 means no returns; null means not set.
  returnDays               Int?
  privacyPolicy            String?
  termsPolicy              String?
  notifyAdminEmails        String?
  notifyOnNewOrder         Boolean  @default(true)
  smsEnabled               Boolean  @default(false)
  isSampleData             Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id         String              @id @default(cuid())
  channel    NotificationChannel
  type       String
  recipient  String
  subject    String?
  status     NotificationStatus
  error      String?
  providerId String?
  orderId    String?
  order      Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt  DateTime            @default(now())

  @@index([status, createdAt])
  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// In-shop point of sale (pos. subdomain)
// ---------------------------------------------------------------------------
// The till sells offline: sales, shifts and receipt numbers are created on
// the device and uploaded later. Each carries a clientId generated on the
// till, so an upload can be retried any number of times without duplicates.

enum PosTender {
  CASH
  MOMO
  CARD
}

enum PosSaleStatus {
  COMPLETED
  VOIDED
}

model PosTill {
  id             String   @id @default(cuid())
  /// Printed in receipt numbers, e.g. "T1" in T1-000231.
  code           String   @unique
  name           String
  isActive       Boolean  @default(true)
  /// Highest receipt number seen from this till, so a reinstalled till
  /// continues the sequence instead of reusing numbers.
  lastReceiptSeq Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shifts  PosShift[]
  sales   PosSale[]
  returns PosReturn[]
}

model PosShift {
  id                String    @id @default(cuid())
  clientId          String    @unique
  tillId            String
  till              PosTill   @relation(fields: [tillId], references: [id])
  cashierId         String
  cashier           User      @relation("PosShiftCashier", fields: [cashierId], references: [id])
  openedAt          DateTime
  openingFloatMinor Int
  closedAt          DateTime?
  // What the cashier counted at close. Expected amounts are worked out
  // from the shift's sales when reporting, so they can never drift.
  countedCashMinor  Int?
  countedMomoMinor  Int?
  countedCardMinor  Int?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  /// A manager looked at the shift's count.
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?     @relation("PosShiftReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote        String?

  sales   PosSale[]
  returns PosReturn[]

  @@index([tillId, openedAt])
  @@index([cashierId, openedAt])
}

model PosSale {
  id                 String        @id @default(cuid())
  clientId           String        @unique
  /// Issued on the till, e.g. "T1-000231".
  receiptNumber      String        @unique
  tillId             String
  till               PosTill       @relation(fields: [tillId], references: [id])
  shiftId            String?
  shift              PosShift?     @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  cashierId          String
  cashier            User          @relation("PosSaleCashier", fields: [cashierId], references: [id])
  status             PosSaleStatus @default(COMPLETED)
  totalMinor         Int
  paidMinor          Int
  changeMinor        Int           @default(0)
  /// More was sold than the recorded stock (usually while offline).
  hasShortfall       Boolean       @default(false)
  /// A line was charged at other than the shelf price for that time and quantity.
  hasPriceDifference Boolean       @default(false)
  /// The till's clock when the sale was made.
  soldAt             DateTime
  syncedAt           DateTime      @default(now())
  /// Cancelled at the till during its own shift; the money went back and the stock was put back.
  voidedAt           DateTime?
  /// The manager who approved the void.
  voidedById         String?
  voidedBy           User?         @relation("PosSaleVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason         String?
  /// A manager looked at a flagged or voided sale.
  reviewedAt         DateTime?
  reviewedById       String?
  reviewedBy         User?         @relation("PosSaleReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote         String?

  items     PosSaleItem[]
  payments  PosPayment[]
  movements InventoryMovement[]
  returns   PosReturn[]

  @@index([soldAt])
  @@index([shiftId])
  @@index([cashierId, soldAt])
}

model PosSaleItem {
  id                 String          @id @default(cuid())
  saleId             String
  sale               PosSale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Snapshot at the time of sale, like OrderItem.
  productName        String
  variantName        String
  sku                String
  unit               SellingUnit
  quantityMilli      Int
  /// What the customer was charged.
  unitPriceMinor     Int
  /// The shelf price for this quantity at soldAt, for comparison.
  listUnitPriceMinor Int
  lineTotalMinor     Int
  /// Part of quantityMilli that was not in recorded stock.
  shortfallMilli     Int             @default(0)
  /// Brought back so far, and the money given back for it.
  returnedMilli      Int             @default(0)
  refundedMinor      Int             @default(0)

  returnItems PosReturnItem[]

  @@index([saleId])
  @@index([variantId])
}

model PosPayment {
  id          String    @id @default(cuid())
  saleId      String
  sale        PosSale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method      PosTender
  amountMinor Int
  /// MoMo transaction ID or card approval code.
  reference   String?

  @@index([saleId])
}

/// Goods brought back from an earlier till sale, and the money given back for
/// them. Recorded online only, with a manager's approval, in the shift the
/// money was paid out of.
model PosReturn {
  id           String    @id @default(cuid())
  /// Issued on the till, so a retried request records the return once.
  clientId     String    @unique
  /// Printed on the refund slip, e.g. RF-000012.
  number       Int       @unique @default(autoincrement())
  saleId       String
  sale         PosSale   @relation(fields: [saleId], references: [id])
  tillId       String
  till         PosTill   @relation(fields: [tillId], references: [id])
  shiftId      String
  shift        PosShift  @relation(fields: [shiftId], references: [id])
  cashierId    String
  cashier      User      @relation("PosReturnCashier", fields: [cashierId], references: [id])
  approvedById String
  approvedBy   User      @relation("PosReturnApprovedBy", fields: [approvedById], references: [id])
  reason       String
  method       PosTender
  /// MoMo transaction ID or card approval code of the refund.
  reference    String?
  refundMinor  Int
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("PosReturnReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?

  items     PosReturnItem[]
  movements InventoryMovement[]

  @@index([saleId])
  @@index([shiftId])
  @@index([createdAt])
}

model PosReturnItem {
  id            String      @id @default(cuid())
  returnId      String
  posReturn     PosReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId    String
  saleItem      PosSaleItem @relation(fields: [saleItemId], references: [id])
  quantityMilli Int
  refundMinor   Int
  /// Put back into sellable stock; damaged or expired goods are not.
  restocked     Boolean

  @@index([returnId])
  @@index([saleItemId])
}
